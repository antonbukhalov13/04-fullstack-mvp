generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String        @id @default(uuid())
  phone        String        @unique
  name         String?
  createdAt    DateTime      @default(now())
  applications Application[]
  otpCodes     OtpCode[]
}

model OtpCode {
  id        String    @id @default(uuid())
  phone     String
  userId    String?
  code      String
  purpose   String    // 'login' | 'sign-loan'
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([phone, purpose])
  @@index([userId])
}

model AdminUser {
  id           String   @id @default(uuid())
  login        String   @unique
  passwordHash String
  role         String   // 'admin' | 'operator'
  createdAt    DateTime @default(now())
}

model Application {
  id            String   @id @default(uuid())
  userId        String
  applicantType String   // 'individual' | 'business'

  // Common fields
  amount   Float
  termDays Int
  status   String   @default("new") // 'new' | 'in_progress' | 'approved' | 'rejected'
  comment  String?
  createdAt DateTime @default(now())

  // Individual fields
  firstName String?
  lastName  String?
  email     String?

  // Business fields
  companyName        String?
  registrationNumber String?
  companyEmail       String?
  companyPhone       String?

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
}

model FileAttachment {
  id           String   @id @default(uuid())
  ownerType    String   // 'application' | 'contact_message' | 'upload'
  ownerId      String?
  s3Key        String
  originalName String
  mimeType     String
  size         Int
  createdAt    DateTime @default(now())

  @@index([ownerType, ownerId])
}
